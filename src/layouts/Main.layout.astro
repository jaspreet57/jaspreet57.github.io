---
import { SITE } from "@helpers/constants";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PolygonBackground from "@components/svg-components/PolygonBackground.astro";
import CursorAnime from "@components/CursorAnime.astro";
import SocialSideBar from "@components/SocialSideBar.astro";
import "src/styles/main.css";

export interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const author = SITE.author;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <meta name="theme-color" content="#FF5C36" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@100;200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/theme-setter.js"></script>
  </head>
  <body>
    <PolygonBackground />
    <CursorAnime />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <SocialSideBar />
    <script is:inline src="./node_modules/preline/preline.js"></script>
  </body>
</html>
